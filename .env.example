# Base de datos libSQL. Sin DATABASE_URL usa el archivo local data/atlas.db.
# En producción: Turso (https://turso.tech) → libsql://<db>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Protege /api/cron/ingest (Vercel Cron lo manda como "Authorization: Bearer …").
CRON_SECRET=

# Servidor propio: correr la ingesta dentro del proceso cada N minutos (vacío = desactivado).
INGEST_INTERVAL_MIN=

# Base de las URLs absolutas de OG y canonical.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
