# Base de datos Turso (libSQL). La integración de Vercel con prefijo STORAGE crea estas dos.
# Para usarlas localmente: npx vercel env pull .env.local
# Sin STORAGE_URL se usa el archivo local data/atlas.db.
STORAGE_URL=
STORAGE_AUTH_TOKEN=

# Protege /api/cron/ingest (Vercel Cron lo manda como "Authorization: Bearer …").
CRON_SECRET=

# Servidor propio: correr la ingesta dentro del proceso cada N minutos (vacío = desactivado).
INGEST_INTERVAL_MIN=

# Base de las URLs absolutas de OG, canonical y sitemap. Vacío: dominio de Vercel o localhost.
# Dominio previsto (sin comprar todavía; no activar hasta que apunte a Vercel):
# NEXT_PUBLIC_SITE_URL=https://mapadedesastres.com
NEXT_PUBLIC_SITE_URL=

# Fase 2 · Bloque B
# NASA FIRMS (focos de calor VIIRS). Clave gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Sin clave, la capa "Focos de calor 24 h" queda desactivada y lo dice.
FIRMS_MAP_KEY=

# ReliefWeb API v2 (ONU OCHA). Nombre de app aprobado: https://apidoc.reliefweb.int/parameters#appname
# Sin él, "Reportes humanitarios" muestra solo el enlace de búsqueda en ReliefWeb.
RELIEFWEB_APPNAME=

# Google Search Console (usar uno de los dos métodos de "Prefijo de URL")
# Etiqueta HTML: solo el código del content="…" de la etiqueta que da Google.
GOOGLE_SITE_VERIFICATION=
# Archivo HTML: el nombre del archivo, por ejemplo google1234567890abcdef.html
GOOGLE_SITE_VERIFICATION_FILE=
