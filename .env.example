# Base de datos Turso (libSQL). La integración de Vercel con prefijo STORAGE crea estas dos.
# Para usarlas localmente: npx vercel env pull .env.local
# Sin STORAGE_URL se usa el archivo local data/atlas.db.
STORAGE_URL=
STORAGE_AUTH_TOKEN=

# Protege /api/cron/ingest (Vercel Cron lo manda como "Authorization: Bearer …").
CRON_SECRET=

# Servidor propio: correr la ingesta dentro del proceso cada N minutos (vacío = desactivado).
INGEST_INTERVAL_MIN=

# Base de las URLs absolutas de OG, canonical y sitemap. Vacío: dominio de Vercel o localhost.
NEXT_PUBLIC_SITE_URL=
